# Copy to .env (do not commit .env). Run: npm run dev:env
# This workstation's browser ALWAYS runs on your own computer.

# Option 1: local Ollama vision model (no outside AI key; install Ollama separately)
# OFFICE_HQ_AI_BACKEND=ollama
# OLLAMA_MODEL=qwen2.5vl:7b

# Option 2: OpenAI API for optional AI reasoning (screenshots sent to OpenAI)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini

# Optional: if Google or other websites don't recognize bundled Chromium,
# use locally installed Chrome, if supported by Playwright.
# OFFICE_HQ_BROWSER_CHANNEL=chrome

# Never put website passwords, cookies, OTP codes, or bank details here.
