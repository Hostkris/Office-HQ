# Copy to .env (do not commit .env). Run: npm run dev:env
# This workstation's browser ALWAYS runs on your own computer.

# Option 1: local Ollama vision model (no outside AI key; install Ollama separately)
# OFFICE_HQ_AI_BACKEND=ollama
# OLLAMA_MODEL=qwen2.5vl:7b

# Option 2: OpenAI API for optional AI reasoning (screenshots sent to OpenAI)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini

# Optional: if Google or other websites don't recognize bundled Chromium,
# use locally installed Chrome, if supported by Playwright.
# OFFICE_HQ_BROWSER_CHANNEL=chrome

# Never put website passwords, cookies, OTP codes, or bank details here.

# Optional OpenMausBot CLI bridge. Start its application and install its CLI separately.
# The port is local to this computer, not the GitHub Pages site.
OFFICE_HQ_OPENMAUS_PORT=8799
# If OpenMausBot requires a paired session, provide the ABSOLUTE path to a privately stored token file.
# OFFICE_HQ_OPENMAUS_TOKEN_FILE=/Users/youruser/.openmausbot-token
# Keep sending disabled until you inspect the starter bot (Ask, browser/computer Off).
# OFFICE_HQ_OPENMAUS_SEND=1

# Agent Reach optional read-only research bridge; disabled until computer owner opts in.
# Check locally with: agent-reach doctor --json
# Install gh and/or yt-dlp for supported public lookups. Do not paste credentials here.
# OFFICE_HQ_RESEARCH_EXECUTE=1
# Never paste OpenMausBot session tokens or OAuth credentials into GitHub files.
